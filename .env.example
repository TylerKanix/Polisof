# All optional, all free. Fields a connector cannot verify stay null.

# Campaign finance + itemised outside spending — https://api.data.gov/signup/
# Without this the FEC connector falls back to DEMO_KEY (~30 requests/hour),
# which is enough to try it, not enough to sync the whole map.
FEC_API_KEY=

# Raises the keyless daily cap on api.census.gov
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ACS 5-year vintage to pull (defaults to 2023)
ACS_YEAR=2023

# Creative-level political ads with spend/impression bands
# Requires an ID-verified Meta developer account
META_AD_TOKEN=
